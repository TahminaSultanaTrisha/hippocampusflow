# Copy to .env and edit. Defaults let you run locally with zero setup (SQLite).
DATABASE_URL=sqlite:///./dev.db
# For real Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hippocampusflow
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Phase 2: get a key at https://console.anthropic.com -> API Keys.
# Costs are per-use; a scan is roughly $0.01-0.03.
ANTHROPIC_API_KEY=
